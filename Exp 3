from collections import deque

def water_jug():
    capacity1 = 4
    capacity2 = 3
    goal = 2

    queue = deque([(0, 0)])
    visited = set()

    while queue:
        x, y = queue.popleft()

        if (x, y) in visited:
            continue

        visited.add((x, y))
        print(x, y)

        if x == goal or y == goal:
            print("Goal Reached")
            break

        states = [
            (capacity1, y),
            (x, capacity2),
            (0, y),
            (x, 0)
        ]

        
        amount = min(x, capacity2 - y)
        states.append((x - amount, y + amount))

        
        amount = min(y, capacity1 - x)
        states.append((x + amount, y - amount))

        for state in states:
            if state not in visited:
                queue.append(state)


water_jug()
